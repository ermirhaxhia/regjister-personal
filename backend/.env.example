# Kopjoje si .env dhe plotëso vlerat reale. .env NUK shkon te git.

# --- Supabase ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Lidhja me Postgres per migrimet (backend/run_migration.py). Perdor POOLER-in, jo hostin direkt:
# Supabase > Project Settings > Database > Connection string > Connection pooling > Transaction mode
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Auth ---
# String sekret personal, i gjatë e i rastësishëm. Vetëm këtu, kurrë te DB.
PIN_PEPPER=

# Sekret për nënshkrimin e token-ave të sesionit (JWT HMAC-SHA256).
# Plotësoje me një string të gjatë të rastësishëm, p.sh. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
SESSION_SECRET=

# --- App ---
CORS_ORIGINS=http://localhost:3000
